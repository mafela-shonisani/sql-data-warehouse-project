/*=========================================================
Bronze Layer Data Load Procedure

This stored procedure loads raw CRM and ERP data
from CSV source files into the Bronze layer tables
of the Data Warehouse.

The procedure first removes existing records from
each Bronze table using TRUNCATE TABLE and then
loads fresh data using BULK INSERT.

Source Data:
- CRM Customer Information
- CRM Product Information
- CRM Sales Details
- ERP Customer Information
- ERP Customer Locations
- ERP Product Categories

This process ensures that the Bronze layer always
contains the latest raw data from the source systems
before further transformations in the Silver layer.
=========================================================*/
```sql
CREATE OR ALTER PROCEDURE bronze.load_bronze
AS
BEGIN

    -- ==========================================
    -- Load CRM Customer Information
    -- ==========================================

    TRUNCATE TABLE bronze.crm_cust_info;

    BULK INSERT bronze.crm_cust_info
    FROM 'C:\Users\mafel\Downloads\sql-data-warehouse-project (1)\sql-data-warehouse-project\datasets\source_crm\cust_info.csv'
    WITH (
        FIRSTROW = 2,
        FIELDTERMINATOR = ',',
        ROWTERMINATOR = '\n',
        TABLOCK
    );

    -- ==========================================
    -- Load CRM Product Information
    -- ==========================================

    TRUNCATE TABLE bronze.crm_prd_info;

    BULK INSERT bronze.crm_prd_info
    FROM 'C:\Users\mafel\Downloads\sql-data-warehouse-project (1)\sql-data-warehouse-project\datasets\source_crm\prd_info.csv'
    WITH (
        FIRSTROW = 2,
        FIELDTERMINATOR = ',',
        ROWTERMINATOR = '\n',
        TABLOCK
    );

    -- ==========================================
    -- Load CRM Sales Details
    -- ==========================================

    TRUNCATE TABLE bronze.crm_sls_details;

    BULK INSERT bronze.crm_sls_details
    FROM 'C:\Users\mafel\Downloads\sql-data-warehouse-project (1)\sql-data-warehouse-project\datasets\source_crm\sales_details.csv'
    WITH (
        FIRSTROW = 2,
        FIELDTERMINATOR = ',',
        ROWTERMINATOR = '\n',
        TABLOCK
    );

    -- ==========================================
    -- Load ERP Customer Information
    -- ==========================================

    TRUNCATE TABLE bronze.erp_cust_az12;

    BULK INSERT bronze.erp_cust_az12
    FROM 'C:\Users\mafel\Downloads\sql-data-warehouse-project (1)\sql-data-warehouse-project\datasets\source_erp\cust_az12.csv'
    WITH (
        FIRSTROW = 2,
        FIELDTERMINATOR = ',',
        ROWTERMINATOR = '\n',
        TABLOCK
    );

    -- ==========================================
    -- Load ERP Customer Locations
    -- ==========================================

    TRUNCATE TABLE bronze.erp_loc_a101;

    BULK INSERT bronze.erp_loc_a101
    FROM 'C:\Users\mafel\Downloads\sql-data-warehouse-project (1)\sql-data-warehouse-project\datasets\source_erp\loc_a101.csv'
    WITH (
        FIRSTROW = 2,
        FIELDTERMINATOR = ',',
        ROWTERMINATOR = '\n',
        TABLOCK
    );

    -- ==========================================
    -- Load ERP Product Categories
    -- ==========================================

    TRUNCATE TABLE bronze.erp_px_cat_g1v2;

    BULK INSERT bronze.erp_px_cat_g1v2
    FROM 'C:\Users\mafel\Downloads\sql-data-warehouse-project (1)\sql-data-warehouse-project\datasets\source_erp\px_cat_g1v2.csv'
    WITH (
        FIRSTROW = 2,
        FIELDTERMINATOR = ',',
        ROWTERMINATOR = '\n',
        TABLOCK
    );

END;
GO
